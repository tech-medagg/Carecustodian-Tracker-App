# Firebase Configuration
# Copy this file to .env and replace with your actual Firebase project values

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Geoapify API Key for destination geocoding (optional fallback)
# REACT_APP_GEOAPIFY_API_KEY=your_geoapify_key_here

# MapMyIndia / Mappls Configuration (Routing, Distance, and Geocoding)
REACT_APP_MAPMYINDIA_PROJECT_ID=your_project_id_here
REACT_APP_MAPMYINDIA_API_KEY=your_api_key_here
REACT_APP_MAPMYINDIA_CLIENT_ID=your_client_id_here
REACT_APP_MAPMYINDIA_CLIENT_SECRET=your_client_secret_here
